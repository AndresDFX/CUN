# Bytecode de Python (regenerable)
__pycache__/
*.py[cod]

# Secretos OAuth de Calendar API (ver config/slides/_secrets/README.md)
# Carpeta con guion bajo a propósito: `secrets` es un módulo de la stdlib y
# config/slides/ va en sys.path[0] de todos los builds.
config/slides/_secrets/credentials.json
config/slides/_secrets/token*.json

# Volcados de `config/evaluaciones/proyectos_sustentacion.py --json`: llevan un campo
# "cedula" por cada integrante. Su sitio es `Especializacion/Evaluaciones/`, donde el
# .gitignore de esa carpeta ignora todo `*.json`; esto es solo el cinturón por si el
# comando se corre desde la raíz con el nombre de ejemplo.
mis_proyectos.json
proyectos_sustentacion*.json

# Temporales de sistema / Google Drive
.DS_Store
Thumbs.db
desktop.ini
*~$*
~$*

# Atajos de Google Docs creados por Google Drive al abrir un .md
*.gdoc
*.gsheet
*.gslides
